{
  "name": "noncom-v.2-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"*.ts\" \"src/**/*.{ts,tsx}\" \"**/*.{md,js,mjs,json,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"*.ts\" \"src/**/*.{ts,tsx}\" \"**/*.{md,js,mjs,json,yml,yaml}\" --ignore-path .gitignore",
    "precommit": "lint-staged && npm run format:check",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src/**/*.{ts,tsx},vite.config.ts}": "eslint --fix",
    "*.{md,js,mjs,json,yml,yaml}": "prettier --write --ignore-path .gitignore"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "js-cookie": "^3.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
